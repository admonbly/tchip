{
  "name": "tchip",
  "version": "1.0.0",
  "private": true,
  "description": "Tchip — Tu parles d'où ? Une expression de la francophonie par jour.",
  "scripts": {
    "verifier": "node tools/verifier-donnees.js",
    "build": "node tools/verifier-donnees.js && node tools/build-www.js",
    "polices": "node tools/copier-polices.js",
    "icones": "node tools/generer-icones.js",
    "sync": "npm run build && npx cap sync",
    "android": "npm run sync && npx cap open android",
    "ios": "npm run sync && npx cap open ios",
    "serve": "node tools/serveur.js",
    "test": "node tools/tests.js",
    "drapeaux": "node tools/copier-drapeaux.js",
    "relecture": "node tools/relecture.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/figtree": "^5.3.0",
    "flag-icons": "^7.6.0",
    "sharp": "^0.35.5"
  }
}
